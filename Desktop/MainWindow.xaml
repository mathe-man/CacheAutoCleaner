<Window x:Class="Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"

        xmlns:local="clr-namespace:Desktop"
        mc:Ignorable="d"
        
        d:DesignHeight="300" d:DesignWidth="500"
        Title="MainWindow" 
        MinHeight="550" Height="600"
        MinWidth="555"  MaxWidth="800" Width="600">
    
    <Grid 
        ColumnDefinitions="2*,21*,3*"
        >
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*" MinHeight="260"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Grid VerticalAlignment="Stretch" Grid.Column="1" Grid.Row="1"
              RowDefinitions="Auto,*" ColumnDefinitions="*,30,100,15">
            
            
            <!-- New item input -->
            <Grid Grid.Row="0" Grid.Column="0"
                  ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                
                <TextBlock Grid.Column="0" Margin="0,10" 
                           Text="New item" FontWeight="DemiBold"
                />
            
                <TextBox x:Name="PathInput" Grid.Column="1" Height="10" Margin="10,0,0,0"
                         FontSize="14" 
                         Text="{Binding NewElementPath, UpdateSourceTrigger=PropertyChanged}"/>

                
            </Grid>
            
            <!-- Items grid -->
            <DataGrid x:Name="ItemsGrid" Grid.Row="1" Grid.Column="0"
                      FontSize="13"
                      MinHeight="200"
                      ItemsSource="{Binding Elements}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserResizeRows="False"
                      GridLinesVisibility="Horizontal"
                      VerticalAlignment="Stretch"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                      VirtualizingPanel.ScrollUnit="Pixel">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Items" 
                                        Binding="{Binding FullPath, Mode=TwoWay}"
                                        Width="*"/>
                </DataGrid.Columns>
                
            </DataGrid>
            
            
            <!-- Utilities buttons -->
            <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                        Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center">
            
                <!-- Add button -->
                <Button Width="100" Margin="0,3, 0,0" 
                        Content="Add" Command="{Binding AddElementCommand}"/>

                <!-- Browse button with dropdown -->
                <Button x:Name="BtnBrowse" Content="Browse ▾" Width="100" Margin="0,9"
                        HorizontalAlignment="Left" Click="BtnBrowse_Click">
                
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="File"   Click="MenuFile_Click"/>
                            <MenuItem Header="Folder" Click="MenuFolder_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            
                <!-- Remove button -->
                <Button Width="100"
                        Content="Remove"
                    
                        Command="{x:Static DataGrid.DeleteCommand}"
                        CommandTarget="{Binding ElementName=ItemsGrid}"/>
            
            
                <Separator Margin="0, 10,0, 20"/>

                <Button Width="100"
                        Content="Clean now"
                    
                        Command="{Binding CleanNowCommand}"/>
            
            </StackPanel>

        </Grid>
            
        
        <StackPanel Grid.Column="1" Grid.Row="2">
            
            <Separator Margin="0,10"/>
            
            <CheckBox x:Name="StayUpCheckBox"
                IsChecked="{Binding StayUpAfterStartupCleaning, UpdateSourceTrigger=PropertyChanged}" 
                Content="Stay up after the startup cleaning"/>
            
            
            
            <TextBlock Margin="0, 13,0,5" 
                Text="Choose how often the cache is cleaned while your computer is running"/>
            
            <StackPanel Orientation="Horizontal">
                
                <Slider x:Name="PeriodSlider" 
                        Margin="5,5"
                        Width="200" HorizontalAlignment="Left"
                        IsSnapToTickEnabled="True"
                        TickPlacement="Both"
                        IsEnabled="{Binding StayUpAfterStartupCleaning}"
                        ValueChanged="PeriodSlider_OnValueChanged"
                        Value="{Binding CleaningPeriodIndex}"
                
                        Maximum="5" Minimum="0"
                        TickFrequency="1"/>
                
                <TextBlock x:Name="PeriodText"
                           Margin="10,0" VerticalAlignment="Center"/>
                
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
