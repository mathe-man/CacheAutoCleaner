<Window x:Class="StartupResident.TrayHost"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tray="clr-namespace:Wpf.Ui.Tray.Controls;assembly=Wpf.Ui.Tray"
        Width="0" Height="0" WindowStyle="None" ShowInTaskbar="False"
        ShowActivated="False" ResizeMode="NoResize">
    
    <Grid>
        <tray:NotifyIcon x:Name="TrayIcon"
                         
                         TooltipText="AutoCacheCleaner"
                         MenuOnRightClick="True"
                         FocusOnLeftClick="False">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Clean now" Click="Clean_Click" />
                    <Separator />
                    <MenuItem Header="Quit" Click="Quit_Click" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>
    </Grid>
</Window>
